{
  "permissions": {
    "deny": [
      "Read(**/perguntas-*.js)",
      "Read(**/figuras-animq-auto-dados.js)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/bloquear-bancos.sh\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/barra-contexto.sh\""
  }
}
